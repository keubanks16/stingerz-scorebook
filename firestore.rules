rules_version = '2';

// GS Baseball Hub security rules.
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
//
// Roles
//   Owner   the first account to claim config/setup; always an admin.
//   Coach   members/{uid} with role 'admin' and status 'approved'; can change everything.
//   Camera  members/{uid} with role 'camera' and status 'approved'; views, streams games,
//           and can attach a replay link to a game. Can't score or change anything else.
//   Family  members/{uid} with role 'parent' and status 'approved'; view only.
// Fees
//   Only the owner, and anyone the owner turns on (members/{uid}.fees == true), can see the
//   fee list and who has paid. Coaches don't get it automatically. A family sees only the pay
//   status of the players a coach linked to their account (members/{uid}.players).
// Who can watch
//   config/access.publicView == true   anyone with the link can view, no sign-in.
//   otherwise                          only approved families and coaches can view.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function isOwner() {
      return signedIn() && exists(docPath('config', 'setup'))
        && get(docPath('config', 'setup')).data.owner == request.auth.uid;
    }
    function myMember() { return get(docPath('members', request.auth.uid)).data; }
    function isApproved() {
      return signedIn() && exists(docPath('members', request.auth.uid)) && myMember().status == 'approved';
    }
    function isAdmin() { return isOwner() || (isApproved() && myMember().role == 'admin'); }
    function isCamera() { return isApproved() && myMember().role == 'camera'; }
    function publicView() {
      return exists(docPath('config', 'access')) && get(docPath('config', 'access')).data.publicView == true;
    }
    function canView() { return publicView() || isApproved() || isAdmin(); }
    function feeAccess() { return isOwner() || (isApproved() && myMember().get('fees', false) == true); }
    function myPlayers() { return isApproved() ? myMember().get('players', []) : []; }

    // Who owns this scorebook. Claimable once, by the first signed-in account; never changed after.
    match /config/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'createdAt']);
    }

    // The "who can watch" switch. Everyone may read it so the page knows whether to ask for a sign-in.
    match /config/access {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['publicView'])
        && request.resource.data.publicView is bool;
    }

    // Cloudflare Worker address and access code, shared with coaches and camera operators.
    match /config/worker {
      allow read: if isAdmin() || isCamera();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['url', 'code']);
      allow delete: if isAdmin();
    }

    // Accounts. A person may only ask for family access for themselves; coaches decide everything else.
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'parent'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'note', 'role', 'status', 'createdAt']);
      // Coaches manage accounts, but only the owner decides who can see fees.
      allow create: if isOwner() || (isAdmin() && !request.resource.data.keys().hasAny(['fees']));
      allow update: if isOwner() || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fees']));
      allow delete: if isAdmin();
    }

    // Team data: roster and settings, games, opponent rosters.
    match /team/{id} {
      allow read: if canView();
      allow write: if isAdmin();
    }
    // Which game is streaming from the built-in camera. Camera operators may update it too.
    match /team/stream {
      allow create, update: if isCamera()
        && request.resource.data.keys().hasOnly(['gid', 'uid', 'whep', 'live', 'startedAt', 'endedAt']);
    }
    match /games/{id} {
      allow read: if canView();
      allow write: if isAdmin();
      // Camera operators may only attach the replay link.
      allow update: if isCamera()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['video', 'updatedAt']);
    }
    match /opponents/{id} {
      allow read: if canView();
      allow write: if isAdmin();
    }
    // Phones that asked for notifications. Each person manages only their own; the Worker reads
    // them with the service account.
    match /pushTokens/{id} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if (isApproved() || isAdmin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'chat', 'scores', 'at'])
        && request.resource.data.scores in ['off', 'runs', 'all'];
      allow update: if (isApproved() || isAdmin()) && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'chat', 'scores', 'at'])
        && request.resource.data.scores in ['off', 'runs', 'all'];
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Where families send money: the owner's Venmo and Cash App, and whether card payments are on.
    match /config/pay {
      allow read: if isApproved() || isAdmin();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['venmo', 'cashapp', 'card'])
        && request.resource.data.venmo is string && request.resource.data.venmo.size() <= 40
        && request.resource.data.cashapp is string && request.resource.data.cashapp.size() <= 40
        && request.resource.data.card is bool;
    }

    // Tournament fees. Families can read a fee (name, amount, due date) so they can pay it.
    match /fees/{id} {
      allow read: if isApproved() || isAdmin();
      allow create, update: if feeAccess()
        && request.resource.data.keys().hasOnly(['name', 'when', 'where', 'amount', 'due', 'players', 'createdAt', 'updatedAt'])
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.players is list;
      allow delete: if feeAccess();

      // One doc per player who has paid or says they paid. Card payments are written only by
      // the Worker after Stripe confirms them (it uses the service account, which skips these rules).
      match /pay/{pid} {
        allow read: if feeAccess() || pid in myPlayers();
        allow create, update: if feeAccess()
          && request.resource.data.keys().hasOnly(['status', 'method', 'amount', 'by', 'at', 'confirmedBy', 'confirmedAt', 'note'])
          && request.resource.data.status in ['paid', 'claimed']
          && request.resource.data.method in ['venmo', 'cashapp']
          && (resource == null || resource.data.method != 'card');
        // A family can only say they paid (a coach confirms), for their own player.
        allow create: if pid in myPlayers()
          && request.resource.data.keys().hasOnly(['status', 'method', 'amount', 'by', 'at'])
          && request.resource.data.status == 'claimed'
          && request.resource.data.method in ['venmo', 'cashapp']
          && request.resource.data.by == request.auth.uid;
        // A card payment stays recorded unless the owner removes it (after refunding it in Stripe).
        allow delete: if isOwner() || (feeAccess() && resource.data.method != 'card')
          || (pid in myPlayers() && resource.data.status == 'claimed');
      }
    }

    // Team chat: one group conversation for signed-in, approved members (not link-only viewers).
    match /messages/{id} {
      allow read: if isApproved() || isAdmin();
      allow create: if (isApproved() || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'coach', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.coach == isAdmin()
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
