rules_version = '2';

// GS Baseball Scorebook security rules.
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
//
// Roles
//   Owner   the first account to claim config/setup; always an admin.
//   Coach   members/{uid} with role 'admin' and status 'approved'; can change everything.
//   Camera  members/{uid} with role 'camera' and status 'approved'; views, streams games,
//           and can attach a replay link to a game. Can't score or change anything else.
//   Family  members/{uid} with role 'parent' and status 'approved'; view only.
// Who can watch
//   config/access.publicView == true   anyone with the link can view, no sign-in.
//   otherwise                          only approved families and coaches can view.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function isOwner() {
      return signedIn() && exists(docPath('config', 'setup'))
        && get(docPath('config', 'setup')).data.owner == request.auth.uid;
    }
    function myMember() { return get(docPath('members', request.auth.uid)).data; }
    function isApproved() {
      return signedIn() && exists(docPath('members', request.auth.uid)) && myMember().status == 'approved';
    }
    function isAdmin() { return isOwner() || (isApproved() && myMember().role == 'admin'); }
    function isCamera() { return isApproved() && myMember().role == 'camera'; }
    function publicView() {
      return exists(docPath('config', 'access')) && get(docPath('config', 'access')).data.publicView == true;
    }
    function canView() { return publicView() || isApproved() || isAdmin(); }

    // Who owns this scorebook. Claimable once, by the first signed-in account; never changed after.
    match /config/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'createdAt']);
    }

    // The "who can watch" switch. Everyone may read it so the page knows whether to ask for a sign-in.
    match /config/access {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['publicView'])
        && request.resource.data.publicView is bool;
    }

    // Cloudflare Worker address and access code, shared with coaches and camera operators.
    match /config/worker {
      allow read: if isAdmin() || isCamera();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['url', 'code']);
      allow delete: if isAdmin();
    }

    // Accounts. A person may only ask for family access for themselves; coaches decide everything else.
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'parent'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'email', 'note', 'role', 'status', 'createdAt']);
      allow create, update, delete: if isAdmin();
    }

    // Team data: roster and settings, games, opponent rosters.
    match /team/{id} {
      allow read: if canView();
      allow write: if isAdmin();
    }
    // Which game is streaming from the built-in camera. Camera operators may update it too.
    match /team/stream {
      allow create, update: if isCamera()
        && request.resource.data.keys().hasOnly(['gid', 'uid', 'whep', 'live', 'startedAt', 'endedAt']);
    }
    match /games/{id} {
      allow read: if canView();
      allow write: if isAdmin();
      // Camera operators may only attach the replay link.
      allow update: if isCamera()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['video', 'updatedAt']);
    }
    match /opponents/{id} {
      allow read: if canView();
      allow write: if isAdmin();
    }
  }
}
